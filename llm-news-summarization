      "source": [
        "import pandas as pd\n",
        "from rouge_score import rouge_scorer\n",
        "\n",
        "# Caminho do arquivo no Google Drive\n",
        "file_path = '/content/drive/MyDrive/CienciaDeDadosAtuariais_2024_1/ResumoModelovsResumoChatGPT.txt'\n",
        "\n",
        "# Função para ler o arquivo e separar os resumos\n",
        "def read_summaries_from_file(file_path):\n",
        "    with open(file_path, 'r', encoding='utf-8') as file:\n",
        "        content = file.read().strip()\n",
        "\n",
        "    # Separar as reportagens usando \"------------------------------------------------\" como delimitador\n",
        "    reports = content.split('------------------------------------------------')\n",
        "\n",
        "    model_summaries = []\n",
        "    reference_summaries = []\n",
        "\n",
        "    for report in reports:\n",
        "        if report.strip():  # Ignorar reportagens vazias\n",
        "            # Separar resumo do modelo e de referência usando \"=====\" como delimitador\n",
        "            parts = report.split('=====')\n",
        "            model_summary = parts[0].split('Resumo do Modelo:')[1].strip() if 'Resumo do Modelo:' in parts[0] else ''\n",
        "            reference_summary = parts[1].split('Resumo de Referência (ChatGPT):')[1].strip() if len(parts) > 1 and 'Resumo de Referência (ChatGPT):' in parts[1] else ''\n",
        "\n",
        "            model_summaries.append(model_summary)\n",
        "            reference_summaries.append(reference_summary)\n",
        "\n",
        "    return model_summaries, reference_summaries\n",
        "\n",
        "# Lista para armazenar as métricas de todos os resumos\n",
        "metrics_list = []\n",
        "\n",
        "# Ler o arquivo e extrair os resumos\n",
        "model_summaries, reference_summaries = read_summaries_from_file(file_path)\n",
        "\n",
        "# Instanciar o calculador de ROUGE\n",
        "scorer = rouge_scorer.RougeScorer(['rouge1', 'rouge2'], use_stemmer=True)\n",
        "\n",
        "# Calcular as métricas ROUGE para cada par de resumos\n",
        "for model_summary, reference_summary in zip(model_summaries, reference_summaries):\n",
