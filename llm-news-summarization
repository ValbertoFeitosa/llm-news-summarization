        "\n",
        "# CRIANDO O LOOP: WHILE / FOR:\n",
        "def resumo_em_loop(texto_completo, max_iters = 5):\n",
        "    resumo_completo = \"\"\n",
        "    iter_count = 0\n",
        "\n",
        "    while iter_count < max_iters:\n",
        "        prompt = f\"\"\"Você é um assistente especializado em sumarização de textos. Ao criar resumos, siga as seguintes instruções:\n",
        "        1. Extraia as informações mais importantes do texto.\n",
        "        2. Evite usar as mesmas palavras presentes no texto original.\n",
        "        3. Utilize sinônimos e reestruture as frases para garantir que o resumo seja único e não apenas uma repetição do texto original.\n",
        "        4. Mantenha o resumo conciso, com no máximo três frases.\n",
        "\n",
        "        Texto: {texto_completo}\n",
        "        Resumo:\"\"\"\n",
        "\n",
        "        # CONVERTENDO AS PALAVRAS OU PARTE DAS PALAVRAS EM TOKENS (números):\n",
        "        tokens = tokenizer(prompt, return_tensors='pt').input_ids.cuda()\n",
        "\n",
        "        # PARAMETROS PARA UMA MELHOR GERAÇÃO DO TEXTO/RESUMO:\n",
        "        parametros_geracao = {\n",
        "            \"do_sample\": True,\n",
        "            \"temperature\": 0.7,\n",
        "            \"top_p\": 0.95,\n",
        "            \"top_k\": 40,\n",
        "            \"max_new_tokens\": 150,\n",
        "            \"repetition_penalty\": 1.1\n",
        "        }\n",
        "\n",
        "        # GERAÇÃO DE NOVOS TOKENS:\n",
        "        saida_geracao = model.generate(tokens, **parametros_geracao)\n",
        "\n",
        "        # DECODIFICAÇÃO DO TEXTO OU CONVERTENDO OS TOKENS EM TEXTO LEGIVEL:\n",
        "        texto_saida = tokenizer.decode(saida_geracao[0], skip_special_tokens=True)\n",
        "\n",
        "        # CONCATENANDO O NOVO RESUMO AO RESUMO ORIGINAL:\n",
        "        resumo_completo += texto_saida.strip() + \" \"\n",
        "\n",
        "        # DEFINIÇÃO DE PARADA:\n",
        "        if texto_saida.strip().endswith('.'):\n",
        "            break\n",
        "\n",
        "        # INCLUINDO NA VARIAVEL O QUE FOI GERADO:\n",
        "        texto_completo = texto_saida.strip()\n",
        "        iter_count += 1 # SOMANDO + 1 NA VARIAVEL ITER_COUNT\n",
        "\n",
        "    return resumo_completo.strip()\n",
        "\n",
        "# EXECUTANDO O LLM:\n",
        "resumo_final = resumo_em_loop(texto)\n",
